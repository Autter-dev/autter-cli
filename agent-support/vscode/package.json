{
  "name": "autter-vscode",
  "displayName": "autter",
  "description": "Keep track of code generated by AI.",
  "version": "0.2.0",
  "icon": "autter.png",
  "publisher": "autter",
  "repository": {
    "type": "git",
    "url": "https://github.com/autter-dev/autter-cli"
  },
  "license": "Apache-2.0",
  "engines": {
    "vscode": ">=1.99.3",
    "node": ">=20.18.1"
  },
  "categories": [
    "AI",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "ai",
    "attribution",
    "authorship",
    "git",
    "tracking"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "autter",
      "properties": {
        "autter.enableCheckpointLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable notifications for AI and human edit detection."
        },
        "autter.experiments.aiTabTracking": {
          "type": "boolean",
          "default": false,
          "description": "Enable tracking for AI tab completion detection (experimental)."
        },
        "autter.showFileAiPercent": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the file-level AI percentage in the status bar."
        },
        "autter.blameMode": {
          "type": "string",
          "enum": [
            "off",
            "line",
            "all"
          ],
          "default": "line",
          "scope": "application",
          "enumDescriptions": [
            "Disable gutter decorations (status bar still shows current line info)",
            "Show gutter decorations for the current line's prompt only",
            "Show gutter decorations for all AI-authored lines in the file"
          ],
          "description": "Control how AI blame attribution is displayed in the editor gutter."
        },
        "autter.findings.display": {
          "type": "string",
          "enum": [
            "inline",
            "problems",
            "off"
          ],
          "default": "inline",
          "scope": "window",
          "enumDescriptions": [
            "Squiggles and Problems entries, plus the finding's title after the affected line",
            "Squiggles and Problems entries only",
            "Don't show review findings in the editor"
          ],
          "description": "How Autter review findings for the current branch's pull request are shown in the editor. Findings are only shown on lines the review saw: a line you've edited since is left unmarked."
        },
        "autter.findings.writeFile": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Keep .autter/findings.md up to date with the findings (summary, location, next steps and a link for each). It is excluded from git."
        }
      }
    },
    "commands": [
      {
        "command": "autter.toggleAICode",
        "title": "Toggle Show AI Code",
        "category": "Autter"
      },
      {
        "command": "autter.findings.reviewChanges",
        "title": "Review My Changes",
        "category": "Autter"
      },
      {
        "command": "autter.findings.refresh",
        "title": "Refresh Review Findings",
        "category": "Autter"
      },
      {
        "command": "autter.findings.openFile",
        "title": "Open Review Findings File",
        "category": "Autter"
      },
      {
        "command": "autter.findings.signIn",
        "title": "Sign In",
        "category": "Autter"
      },
      {
        "command": "autter.findings.restoreDismissed",
        "title": "Show Dismissed Review Findings Again",
        "category": "Autter"
      },
      {
        "command": "autter.findings.copyFixPrompt",
        "title": "Copy Fix Prompt",
        "category": "Autter"
      },
      {
        "command": "autter.findings.openInDashboard",
        "title": "Open Finding in Dashboard",
        "category": "Autter"
      },
      {
        "command": "autter.findings.dismiss",
        "title": "Dismiss Review Finding",
        "category": "Autter"
      }
    ],
    "keybindings": [
      {
        "command": "autter.toggleAICode",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "autter.findings.copyFixPrompt",
          "when": "false"
        },
        {
          "command": "autter.findings.openInDashboard",
          "when": "false"
        },
        {
          "command": "autter.findings.dismiss",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "npm run copy-static && npm run compile && vsce package",
    "copy-static": "cp ../../assets/docs/autter.png ./autter.png",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.59.4",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "eslint": "^10.3.0",
    "ovsx": "0.10.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": ">=11.1.0",
    "tar-fs": ">=2.1.4",
    "test-exclude": ">=7.0.0"
  },
  "dependencies": {
    "posthog-node": "^5.35.14"
  }
}
